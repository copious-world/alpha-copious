$$verbatim::{
//  === ---------------------------------------  === ---------------------------------------  === ---------------------------------------

function set_user_title(u_name) {
	let el = document.getElementById('active-user-title')
	if ( el  && u_name && (typeof u_name === "string") ) {
		el.innerHTML = u_name
	}
}

}
