@params<{sections : %file%, fixed_items : %file%}>

<main>
	<div class="items">

		<div class="item" style="font-family:Arial, Helvetica, sans-serif;background-color: rgb(248, 244, 236);margin-left:9px;width:94%;margin-left:8px;" >
            <div id="sections-header"  style="font-size: x-large;font-weight: bold;text-align: center;margin-bottom: 9px;border-bottom:solid 1px rgba(111, 42, 4, 0.528)">
                <span style="color: #122b04f8;">{{section_header_title}}</span>
                <div style="display:inline;float:right;font-weight: bolder;height:50%;color:rgb(14, 50, 14);">&#11015;</div>
            </div>
            <div id="sections-container"  style="padding-left:1%;padding-right:1%;font-weight: 500;color:#2f4306;height: 300px;">
                <div class="flowing-column" style="padding:4px;height: inherit;" onscrollend="scrollender(event)" onscroll="scroller(event)">
				@{sections}
                </div>
            </div>
            <br>
            <div style="text-align: right;">
                <button class="phone-button" id="topicBox_3-btn" style="width:fit-content;padding-left:1px;padding-right:1px;"	onmouseup="pinBox('#topicBox_3')" onmouseover="defadeBox('#topicBox_3')" onmouseleave="fade_apparition(this,event)" >&nbsp;{{phone_button_use}}&nbsp;</button>
            </div>
		</div>

		@{fixed_items}

		<div id="lowerFiller" class="fillLowerWrap">
			<div class="fillLower">
				alpha test
			</div>
		</div>
	</div>
</main>
	